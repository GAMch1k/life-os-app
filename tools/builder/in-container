#!/usr/bin/env bash
# Runs inside the builder container; start it through tools/build, not directly.
#
#   in-container test     unit tests (of the release variant)
#   in-container release  unit tests, signed release APKs, checks, dist/
#
# Each step is its own Gradle invocation and prints its time and peak memory.
set -euo pipefail

# The release signing certificate (public information, not a secret).
expected_cert_sha256=ABA979EC4A64CC646036BAF6C9764A54635547BCC2583C59BB6AE33A8D1EEF9F
application_id=com.gamch1k.lifeos

die() { echo "in-container: $*" >&2; exit 1; }

gradle() { ./gradlew --no-daemon --console=plain "$@"; }

# The Gradle client (the wrapper's JVM) only relays the build's output; keep
# it small. The build JVM's own settings are org.gradle.jvmargs.
export GRADLE_OPTS="-XX:+UseSerialGC -XX:TieredStopAtLevel=1 -XX:ReservedCodeCacheSize=32m"
# Fewer glibc malloc arenas for the JVMs' native memory (JIT compilers, zip,
# R8, lint): less fragmentation, a slightly smaller resident size.
export MALLOC_ARENA_MAX=2

# Memory of this container, sampled every second from its cgroup:
#   process memory = "anon" (JVM heaps, metaspace, native memory of every process);
#   working set    = usage minus inactive page cache (what `docker stats` shows);
#   cgroup peak    = memory.peak, which also counts the page cache of every file
#                    read or written, so it climbs to the limit while staying harmless.
# The sampler keeps the peaks of the whole run and of the current step; USR1
# starts a new step.
cgroup=/sys/fs/cgroup
peaks=/tmp/memory-peaks
sample_memory() {
  local peak_anon=0 peak_ws=0 step_anon=0 step_ws=0 anon inactive current
  trap 'step_anon=0; step_ws=0' USR1
  while sleep 1; do
    anon=$(awk '$1 == "anon" { print $2 }' "$cgroup/memory.stat")
    inactive=$(awk '$1 == "inactive_file" { print $2 }' "$cgroup/memory.stat")
    current=$(cat "$cgroup/memory.current")
    if ((anon > peak_anon)); then
      peak_anon=$anon
      # The five largest processes; Gradle's JVMs are named: GradleDaemon (the build),
      # GradleWrapper (the client), GradleWorkerMain (a test JVM).
      ps -eo rss=,args= --sort=-rss | head -n 5 | awk '{
        name = $2; sub(".*/", "", name)
        for (i = 2; i <= NF; i++) {
          if ($i ~ /gradle-wrapper[.]jar$/) { name = "GradleWrapper"; break }
          if ($i ~ /^(org|worker)[.].*[.](GradleDaemon|Gradle[A-Za-z]*Main)$/) { name = $i; sub(".*[.]", "", name); break }
        }
        printf "%s %d MiB; ", name, $1 / 1024
      }' > "$peaks.ps"
    fi
    ((anon > step_anon)) && step_anon=$anon
    ((current - inactive > peak_ws)) && peak_ws=$((current - inactive))
    ((current - inactive > step_ws)) && step_ws=$((current - inactive))
    echo "$peak_anon $peak_ws $step_anon $step_ws" > "$peaks"
  done
}
report_memory() {
  kill "$sampler" 2> /dev/null || true
  [[ -r $peaks ]] || return 0
  local anon ws peak
  read -r anon ws _ < "$peaks"
  peak=$(cat "$cgroup/memory.peak" 2> /dev/null || echo 0)
  echo "memory: peak process memory $((anon / 1048576)) MiB, peak working set $((ws / 1048576)) MiB," \
    "cgroup peak incl. page cache $((peak / 1048576)) MiB, limit $(($(cat "$cgroup/memory.max") / 1048576)) MiB"
  echo "largest processes at the process-memory peak: $(cat "$peaks.ps" 2> /dev/null)"
}
sampler=
if [[ -r $cgroup/memory.stat ]]; then
  sample_memory &
  sampler=$!
  trap report_memory EXIT
fi

# step <name> <gradle arguments...>: one Gradle invocation, so one fresh JVM.
# A JVM's heap, metaspace and code cache hardly shrink once grown, so running
# the unit tests and each app in their own JVM keeps the peak at the largest
# step instead of everything the build ever loaded.
step() {
  local name=$1 start=$SECONDS step_anon=0 step_ws=0
  shift
  gradle "$@"
  if [[ -n $sampler ]]; then
    sleep 1
    [[ -r $peaks ]] && read -r _ _ step_anon step_ws < "$peaks"
    kill -USR1 "$sampler" 2> /dev/null || true
  fi
  echo "step $name: $((SECONDS - start)) s, peak process memory $((step_anon / 1048576)) MiB, peak working set $((step_ws / 1048576)) MiB" >&2
}

# Reads one field out of `aapt2 dump badging` output.
badging_field() { # <badging> <regex with one group>
  sed -n "s/$2/\1/p" <<< "$1" | head -n 1
}

verify_and_copy() { # <module> -> prints the release.json entry
  local module=$1 apk badging package version_code version_name min_sdk certs signers cert dest
  apk="$module/build/outputs/apk/release/$module-release.apk"
  [[ -f $apk ]] || die "$apk was not built"

  badging=$(aapt2 dump badging "$apk")
  package=$(badging_field "$badging" "^package: name='\([^']*\)'.*")
  version_code=$(badging_field "$badging" "^package: .* versionCode='\([0-9]*\)'.*")
  version_name=$(badging_field "$badging" "^package: .* versionName='\([^']*\)'.*")
  min_sdk=$(badging_field "$badging" "^minSdkVersion:'\([0-9]*\)'.*")
  [[ -n $min_sdk ]] || min_sdk=$(badging_field "$badging" "^sdkVersion:'\([0-9]*\)'.*")
  [[ $package == "$application_id" ]] || die "$apk has applicationId '$package', expected $application_id"
  [[ -n $version_code && -n $version_name && -n $min_sdk ]] || die "could not read the version of $apk"

  apksigner verify --min-sdk-version "$min_sdk" "$apk" || die "$apk does not verify"
  certs=$(apksigner verify --print-certs "$apk")
  signers=$(grep -c '^Signer #[0-9]* certificate SHA-256 digest:' <<< "$certs" || true)
  cert=$(sed -n 's/^Signer #1 certificate SHA-256 digest: //p' <<< "$certs" | tr 'a-f' 'A-F')
  [[ $signers == 1 ]] || die "$apk has $signers signers, expected exactly one"
  [[ $cert == "$expected_cert_sha256" ]] || die "$apk is signed with $cert, not the release key"

  dest="dist/lifeos-$module-$version_name-$version_code.apk"
  cp "$apk" "$dest"
  echo "$module: $dest, $package $version_name ($version_code), minSdk $min_sdk, release key OK" >&2

  printf '    "%s": {\n' "$module"
  printf '      "file": "%s",\n' "${dest#dist/}"
  printf '      "applicationId": "%s",\n' "$package"
  printf '      "versionCode": %s,\n' "$version_code"
  printf '      "versionName": "%s",\n' "$version_name"
  printf '      "minSdk": %s,\n' "$min_sdk"
  printf '      "sha256": "%s",\n' "$(sha256sum "$dest" | cut -d' ' -f1)"
  printf '      "size": %s,\n' "$(stat -c %s "$dest")"
  printf '      "builtAt": "%s",\n' "$built_at"
  printf '      "gitCommit": "%s"\n' "${LIFEOS_GIT_COMMIT:-unknown}"
  printf '    }'
}

case "${1:-}" in
  test)
    step "unit tests" testReleaseUnitTest
    ;;
  release)
    [[ -n ${LIFEOS_KEYSTORE_PROPERTIES:-} ]] || die "LIFEOS_KEYSTORE_PROPERTIES is not set"
    # The unit tests run against the release variant, as in `test`: its
    # classes are the ones the APKs are built from, so nothing is compiled
    # twice. One worker while assembling: R8 and lint, each wanting much of
    # the heap, never run side by side.
    step "unit tests" testReleaseUnitTest
    step phone --max-workers=1 :phone:assembleRelease
    step wear --max-workers=1 :wear:assembleRelease
    built_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    mkdir -p dist
    rm -f dist/*.apk dist/release.json
    phone=$(verify_and_copy phone)
    wear=$(verify_and_copy wear)
    printf '{\n  "schema": 1,\n  "apps": {\n%s,\n%s\n  }\n}\n' "$phone" "$wear" > dist/release.json
    echo "wrote dist/release.json" >&2
    ls -l dist >&2
    ;;
  *)
    die "usage: in-container test|release"
    ;;
esac
