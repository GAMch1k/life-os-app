<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET and ACCESS_NETWORK_STATE come from :core. -->

    <!-- Voice notes. The camera is used through the camera app's intent, which needs no permission. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Self-update (P18-09): install our own APK, silently once this app installed the current version. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Push notifications (P18-05): showing them, and receiving FCM through Play services. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" />

    <!-- Updating the watch app (P19-06, 0.4.3): the push runs in a foreground service of type
         connectedDevice with a progress notification and a partial wake lock. Android 14+ wants the
         type's permission and, for connectedDevice, one of a list of others: CHANGE_NETWORK_STATE
         (a normal permission) is that one. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <queries>
        <!-- The camera app for photos, and a browser for Custom Tabs. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".LifeOsApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeOS">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|locale|layoutDirection"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The link to the watch app (docs/wear.md): token handoff, API relay, the watch's update reports. -->
        <service
            android:name=".wearlink.PhoneWearLinkService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.REQUEST_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/lifeos/" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/lifeos/" />
            </intent-filter>
            <!-- The watch app's reports: its version and its last install (P19-06). -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/lifeos/" />
            </intent-filter>
        </service>

        <!-- The push of a wear APK to the watch (docs/wear.md "Install and updates"). -->
        <service
            android:name=".watch.WatchUpdateService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Share → Life OS: text, links and images from any app (P18-04). -->
        <activity
            android:name=".share.ShareActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|locale|layoutDirection"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_label"
            android:taskAffinity=""
            android:theme="@style/Theme.LifeOS.Share"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <!-- Push (P18-05): UnifiedPush hands endpoints and decrypted messages to this service. -->
        <service
            android:name=".push.LifeOsPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <!-- A notification's Done. -->
        <receiver
            android:name=".push.NotificationActionReceiver"
            android:exported="false" />

        <!-- "Life OS Capture" in the app list (P18-12): straight into a voice recording, over the lock
             screen too; for the side key's double press (README). Its own task, out of Recents. -->
        <activity
            android:name=".ui.VoiceCaptureActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|locale|layoutDirection"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@mipmap/ic_capture"
            android:label="@string/capture_launcher"
            android:launchMode="singleTask"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home-screen widgets (P18-07). -->
        <receiver
            android:name=".today.TodayWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_today_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>
        <receiver
            android:name=".today.QuickCaptureWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_capture_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_capture_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
